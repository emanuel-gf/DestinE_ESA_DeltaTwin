{
    "name": "get-sen2-product",
    "description": "Prototype version of querying STAC catalog for most recent Sentinel-2 L1C and L2A items.",
    "license": {
        "name": "LGPLv3",
        "url": "https://www.gnu.org/licenses/gpl-3.0.txt",
        "description": "",
        "copyrights": [
            {
                "years": [
                    2025
                ],
                "company": "European Space Agency"
            }
        ]
    },
    "owner": "emanuel.goulart",
    "inputs": {
        "cdse_key": {
            "type": "string",
            "description": "CDSE ACCESS_KEY_ID"
        },
        "cdse_secret": {
            "type": "string",
            "description": "CDSE SECRET ACCESS KEY"
        },
        "bands":{
            "type":"string",
            "description":"Sentinel-2 Bands (e.g: B02,B03,B04)"
        },
        "product_level":{
            "type":"string",
            "description":"Level of processing for Sentinel-2 (e.g: L2A OR L1C)"
        },
        "stac_item":{
            "type":"Data",
            "description":"A STAC ITEM transformed in a dictionary and stored on a json."
        }
    },
    "outputs": {
        "s2_raw": {
            "type": "Data",
            "description": "A np.ndarray compressed format representing L1C product"
        }
    },
    "models": {
        "get_product": {
            "path": "models",
            "type": "python",
            "parameters": {
                "pythonVersion": "3.12.2",
                "pipRequirements": [
                { "name": "numpy", "version": "1.26.4" },
                { "name": "pandas", "version": "2.2.3" },
                { "name": "pystac-client", "version": "0.8.6" },
                {"name":"pystac", "version":"1.13.0"},
                { "name": "dotenv", "version": "0.9.9" },
                { "name": "loguru", "version": "0.7.3" },
                { "name": "PyYAML", "version": "6.0.1" },
                {"name": "Pillow", "version": "10.1.0"},
                {"name": "boto3","version": "1.34.20"},
                {"name": "lxml",  "version": "5.3.1"}
                ],
                "hardwareRequirements": {
                    "cpu": "4000m",
                    "ram": "4Gi"
                },
                "command": "python main.py $(inputs.cdse_key) $(inputs.cdse_secret) $(inputs.bands) $(inputs.product_level) $(inputs.stac_item)"
            },
            "inputs": {
                "cdse_key": {
                    "type": "string"
                },
                "cdse_secret": {
                    "type": "string"
                },
                "bands": {
                    "type": "string"
                },
                "product_level":{
                    "type":"string"
                },
                "stac_item":{
                    "type":"Data"
                }
            },
            "outputs": {
                "s2_raw": {
                    "type": "Data",
                    "glob": "s2_raw.npz"
                }
            }
        }
    }
}