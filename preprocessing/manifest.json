{
    "name": "preprocessing-s2-ai-atmospheric-correction",
    "description": "Prototype version of the preprocessing step for applying AI on atmospheric correction.",
    "license": {
        "name": "LGPLv3",
        "url": "https://www.gnu.org/licenses/gpl-3.0.txt",
        "description": "",
        "copyrights": [
            {
                "years": [
                    2025
                ],
                "company": "European Space Agency"
            }
        ]
    },
    "owner": "sebastien.tetauld, emanuel.goulart",
    "inputs": {
        "s2_raw": {
            "type": "string",
            "description": "Path for a compressed Numpy object containing an ndarray with the bands. "
        }
    },
    "outputs": {
        "x_tensor": {
            "type": "Data",
            "description": "A Pytorch Tensor Preprocessed for all bands."
        },
        "valid_mask": {
        "type":"Data",
        "description":"A valid mask covering the scene. Saved as a compressed numpy object."}
    },
    "models": {
        "preprocessing": {
            "path": "models/src",
            "type": "python",
            "parameters": {
                "pythonVersion": "3.12.2",
                "pipRequirements": [
                { "name": "numpy", "version": "1.26.4" },
                { "name": "dotenv", "version": "0.9.9" },
                { "name": "loguru", "version": "0.7.3" },
                {"name": "timm", "version": "1.0.15" },
                {"name": "opencv-python-headless", "version": "4.10.0.84"},
                {"name": "lxml", "version": "5.3.1"},
                {"name":"Pillow", "version": "10.1.0"}
                ],
                "hardwareRequirements": {
                    "cpu": "2000m",
                    "ram": "3Gi"
                },
                "command": "python main.py $(inputs.s2_raw)"
            },
            "inputs": {
                "s2_raw": {
                    "type": "string"
                }
            },
            "outputs": {
                "x_tensor": {
                    "type": "Data",
                    "glob": "s2_preprocessed.pt"
                },
                "valid_mask":{
                    "type": "Data",
                    "glob": "valid_mask_preprocessed.npz"
                }
            }
        }
    }
}