{
    "name": "inference-s2-ai-atmospheric-correction",
    "description": "Prototype version of the prediction step for applying AI on atmospheric correction.",
    "license": {
        "name": "LGPLv3",
        "url": "https://www.gnu.org/licenses/gpl-3.0.txt",
        "description": "",
        "copyrights": [
            {
                "years": [
                    2025
                ],
                "company": "European Space Agency"
            }
        ]
    },
    "owner": "sebastien.tetauld, emanuel.goulart",
    "inputs": {
        "s2_preprocessed": {
            "type": "string",
            "description": "Path for a ndarray object containing the bands and the image. Already preprocessed. "
        }
    },
    "outputs": {
        "pred_tensor": {
            "type": "Data",
            "description": "Inference prediction of the model. A Torch Tensor object containing the bands but stored as a numpy ndarray "
        }
    },
    "models": {
        "inference": {
            "path": "models/src",
            "type": "python",
            "parameters": {
                "pythonVersion": "3.12.2",
                "pipRequirements": [
                { "name": "numpy", "version": "1.26.4" },
                { "name": "python-dotenv", "version": "1.1.0" },
                { "name": "loguru", "version": "0.7.3" },
                { "name": "PyYAML", "version": "6.0.1" },
                {"name": "torch", "version": "2.6.0" },
                {"name": "segmentation-models-pytorch","version": "0.4.0"},
                {"name": "timm", "version": "1.0.15" },
                {"name": "opencv-python-headless", "version": "4.11.0.86"}
                ],
                "hardwareRequirements": {
                    "cpu": "2000m",
                    "ram": "6Gi"
                },
                "command": "python main.py $(inputs.s2_preprocessed)"
            },
            "inputs": {
                "s2_preprocessed": {
                    "type": "string"
                }
            },
            "outputs": {
                "pred_tensor": {
                    "type": "Data",
                    "glob": "pred_tensor.npz"
                }
            }
        }
    }
}